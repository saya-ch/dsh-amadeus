<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ SplashScreen：透明图标 + 暖米白底，避免开屏闪 app icon -->
<resources>
  <style name="Theme.AmadeusWhale" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowSplashScreenBackground">#F7EFE4</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    <item name="android:statusBarColor">#F7EFE4</item>
    <item name="android:navigationBarColor">#F7EFE4</item>
    <item name="android:windowBackground">#F7EFE4</item>
  </style>
</resources>
